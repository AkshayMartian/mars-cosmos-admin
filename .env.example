# Copy to .env (never commit .env). Every value here is a placeholder.

# Server
PORT=4100
HOST=127.0.0.1
# The web app's address (browser origin allowed to call the API)
CORS_ORIGIN=http://localhost:5173
# Address the owner's PIN-reset link in the email opens (the web app). Use the real https address in production.
WEB_URL=http://localhost:5173

# MongoDB Atlas: a DATABASE USER's connection string (Atlas > Database Access), not your Atlas login.
# Leave empty to run the server without a database (only /health works).
MONGODB_URI=
MONGODB_DB=mars_pos

# Licence signing (Ed25519 private key, PEM). The app only holds the matching PUBLIC key.
# Make a pair with: npm run licence:keygen -w server  , keep the private key out of git.
LICENCE_PRIVATE_KEY_FILE=

# One-time codes are stored hashed with this secret. Required in production (any long random string).
OTP_SECRET=
# Where owner photos are saved (a folder on the server)
UPLOAD_DIR=./uploads
# WhatsApp: console = print codes/keys to the server log (development). live = send on WhatsApp Business.
MESSENGER=console
# Email is real as soon as SMTP_URL is set (independent of MESSENGER). e.g. Gmail: smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# WhatsApp (MESSENGER=live) needs the token, phone number id and approved templates:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=mars_verification_code
WHATSAPP_KEY_TEMPLATE=mars_activation_key
WHATSAPP_TEMPLATE_LANG=en
SMTP_URL=
SMTP_FROM=MARS Cosmos <no-reply@example.com>
